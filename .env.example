# DataForSEO credentials (required for real search-demand research).
# Never commit real values; this file documents names only.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# Optional: override the DataForSEO API base URL (default https://api.dataforseo.com).
# DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Etsy Open API v3 app keystring (required for real marketplace research).
# Create an app at https://www.etsy.com/developers/register — never commit real values.
ETSY_API_KEY=your-etsy-app-keystring

# Optional: override the Etsy API base URL (default https://openapi.etsy.com).
# ETSY_BASE_URL=https://openapi.etsy.com

# Optional cost controls for marketplace research (defaults shown).
# Maximum provider HTTP calls per research request (searches + review lookups).
# MARKETPLACE_MAX_PROVIDER_CALLS=40
# Maximum unique marketplace queries researched per request.
# MARKETPLACE_MAX_QUERIES=20
# Maximum listings kept per query.
# MARKETPLACE_MAX_RESULTS_PER_QUERY=25
# Maximum per-listing review lookups per request (each costs one API call).
# MARKETPLACE_MAX_REVIEW_LOOKUPS=20

# Optional cost controls for search-demand research (defaults shown).
# Maximum provider HTTP calls per research request.
# SEARCH_DEMAND_MAX_PROVIDER_CALLS=5
# Maximum unique keywords researched per request.
# SEARCH_DEMAND_MAX_KEYWORDS=200
