# DataForSEO credentials (required for real search-demand research).
# Never commit real values; this file documents names only.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# Optional: override the DataForSEO API base URL (default https://api.dataforseo.com).
# DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Optional cost controls for search-demand research (defaults shown).
# Maximum provider HTTP calls per research request.
# SEARCH_DEMAND_MAX_PROVIDER_CALLS=5
# Maximum unique keywords researched per request.
# SEARCH_DEMAND_MAX_KEYWORDS=200

# Etsy Open API v3 keystring (required for real marketplace research).
# Create an app at https://www.etsy.com/developers; commercial use requires
# Etsy's approval. Never commit real values; this file documents names only.
ETSY_API_KEY=your-etsy-keystring

# Optional: override the Etsy API base URL (default https://openapi.etsy.com).
# ETSY_BASE_URL=https://openapi.etsy.com

# Optional usage controls for marketplace research (defaults shown).
# Maximum provider HTTP calls per research request (searches + review lookups).
# MARKETPLACE_MAX_PROVIDER_CALLS=10
# Maximum unique marketplace queries per request.
# MARKETPLACE_MAX_QUERIES=25
# Maximum listings requested per query (Etsy caps a page at 100).
# MARKETPLACE_MAX_LISTINGS_PER_QUERY=25
# Maximum per-listing review-count lookups per request (0 disables them).
# MARKETPLACE_MAX_REVIEW_LOOKUPS=20

# YouTube Data API v3 key (required for real public-content research).
# Create one in Google Cloud Console with the YouTube Data API enabled.
# Never commit real values; this file documents names only.
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: override the YouTube API base URL (default https://www.googleapis.com/youtube/v3).
# YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# Optional usage controls for public-content research (defaults shown).
# YouTube bills quota units, not dollars: one search pass costs 101 units
# (search=100 + videos=1); one channel-stats batch costs 1 unit.
# Maximum provider HTTP calls per research request.
# PUBLIC_CONTENT_MAX_PROVIDER_CALLS=20
# Maximum unique content queries per request.
# PUBLIC_CONTENT_MAX_QUERIES=25
# Maximum videos requested per query (YouTube caps a page at 50).
# PUBLIC_CONTENT_MAX_VIDEOS_PER_QUERY=10
# Maximum quota units spent per request (project default quota is 10,000/day).
# PUBLIC_CONTENT_MAX_QUOTA_UNITS=1000
# Maximum batched channel-stats calls per request (each covers up to 50 channels; 0 disables).
# PUBLIC_CONTENT_MAX_CHANNEL_LOOKUPS=2

# --- Quarantined experimental scoring (leave unset) ---------------------
# app/services/scoring.py holds UNAPPROVED placeholder POS weights, Evidence
# Confidence weights, kill rules, and RED/YELLOW/GREEN thresholds. The
# POST /score endpoint that exposed them is disabled by default and returns
# 410 Gone, so unapproved scoring cannot be presented as a product result.
# Set this to true only for local development on that legacy code.
# ENABLE_EXPERIMENTAL_SCORING=false
