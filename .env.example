# DataForSEO credentials (required for real search-demand research).
# Never commit real values; this file documents names only.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# Optional: override the DataForSEO API base URL (default https://api.dataforseo.com).
# DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Optional cost controls for search-demand research (defaults shown).
# Maximum provider HTTP calls per research request.
# SEARCH_DEMAND_MAX_PROVIDER_CALLS=5
# Maximum unique keywords researched per request.
# SEARCH_DEMAND_MAX_KEYWORDS=200
